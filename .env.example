# ── Supabase ──────────────────────────────────────────────────────────────────
# Dari dashboard Supabase: Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOi...
# Service role: HANYA dipakai di server (admin panel & API). Jangan pernah dibocorkan.
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOi...

# ── Admin panel ───────────────────────────────────────────────────────────────
# Satu password bersama untuk semua pengurus, minimal 12 karakter.
# Mengganti nilainya otomatis mengeluarkan semua sesi yang sedang login.
ADMIN_PASSWORD=

# ── Situs ─────────────────────────────────────────────────────────────────────
NEXT_PUBLIC_SITE_URL=https://janjipengharapan.com

# ── Notifikasi email (Resend) ─────────────────────────────────────────────────
# Kosongkan kalau belum dipakai — form tetap jalan, notifikasi dilewati.
RESEND_API_KEY=
NOTIFY_EMAIL_FROM="Janji Pengharapan <noreply@janjipengharapan.com>"
NOTIFY_EMAIL_TO=pengurus@janjipengharapan.com

# ── Notifikasi WhatsApp (Fonnte) ──────────────────────────────────────────────
# Token dari https://fonnte.com — kosongkan kalau belum dipakai.
FONNTE_TOKEN=
# Nomor tujuan, format 62xxxx. Pisahkan dengan koma untuk beberapa pengurus.
NOTIFY_WA_TO=628123456789
